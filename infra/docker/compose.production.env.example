# Production environment template. Copy to compose.production.env and set real values.
APEX_AI_PROVIDER=light
APEX_DEBUG=false
APEX_LOG_LEVEL=INFO
APEX_CORS_ORIGINS=https://your-production-host.example
APEX_RENDER_MAX_DIM=2048
# Generate a long random secret. Persistent scene caching is disabled without it.
APEX_CACHE_SIGNING_KEY=replace-with-a-long-random-secret
